alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE Redtail/XMRig Stratum JSON-RPC mining.subscribe"; flow:to_server,established; content:"{\"id\":"; depth:6; content:"\"method\""; nocase; distance:0; within:40; content:"\"mining.subscribe\""; nocase; distance:0; within:120; sid:9001031; rev:1; priority:2; classtype:trojan-activity;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE Redtail/XMRig Stratum JSON-RPC mining.authorize"; flow:to_server,established; content:"{\"id\":"; depth:6; content:"\"method\""; nocase; distance:0; within:40; content:"\"mining.authorize\""; nocase; distance:0; within:120; sid:9001032; rev:1; priority:2; classtype:trojan-activity;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"MALWARE Redtail/XMRig Stratum JSON-RPC mining.notify"; flow:to_client,established; content:"{\"params\""; nocase; depth:10; content:"\"method\""; nocase; distance:0; within:60; content:"\"mining.notify\""; nocase; distance:0; within:160; sid:9001033; rev:1; priority:2; classtype:trojan-activity;)

